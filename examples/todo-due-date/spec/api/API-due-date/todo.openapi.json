{
  "openapi": "3.1.0",
  "info": { "title": "Todo API", "version": "1.0.0" },
  "paths": {
    "/todos": {
      "get": {
        "operationId": "listTodos",
        "x-requirements": ["REQ-due-date#R4"],
        "parameters": [{ "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["dueDate"] } }],
        "responses": { "200": { "description": "Todo list" } }
      }
    },
    "/todos/{id}": {
      "patch": {
        "operationId": "updateTodo",
        "x-requirements": ["REQ-due-date#R1"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TodoPatch" } } }
        },
        "responses": {
          "200": { "description": "Updated todo" },
          "400": { "description": "VALIDATION_ERROR" },
          "404": { "description": "Todo not found" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Todo": {
        "type": "object",
        "required": ["id", "title", "completed", "dueDate"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "completed": { "type": "boolean" },
          "dueDate": { "type": ["string", "null"], "format": "date" }
        }
      },
      "TodoPatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "dueDate": { "type": ["string", "null"], "format": "date" } }
      }
    }
  }
}
